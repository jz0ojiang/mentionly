{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@playground/shared": ["./playground/shared/index.ts"],
      "@playground/shared/*": ["./playground/shared/*"],
      "mentionly": ["./packages/mentionly/src/index.ts"],
      "@mentionly/vue": ["./packages/vue/src/index.ts"],
      "@mentionly/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["playground/**/*"],
  "exclude": ["node_modules", "dist", "playground-dist"]
}
