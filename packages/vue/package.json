{
  "name": "@mentionly/vue",
  "version": "2.0.0",
  "type": "module",
  "description": "Vue 3 mention input component for AI chat scenarios",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/mentionly.css"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jz0ojiang/mentionly.git",
    "directory": "packages/vue"
  },
  "homepage": "https://im0o.top/mentionly",
  "bugs": "https://github.com/jz0ojiang/mentionly/issues",
  "scripts": {
    "build": "vite build && bun ../../scripts/build-llms.ts vue",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mentionly/core": "^2.0.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.28",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "mention",
    "chat",
    "input",
    "contenteditable",
    "ai",
    "at-mention"
  ],
  "author": "jz0ojiang <hi@im0o.top> (https://github.com/jz0ojiang)",
  "license": "MIT"
}
