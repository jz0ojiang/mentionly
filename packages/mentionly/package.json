{
  "name": "mentionly",
  "version": "2.0.0-next.0",
  "type": "module",
  "description": "Lightweight Vue 3 mention input component for AI chat scenarios",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/mentionly.css"
  },
  "files": [
    "dist",
    "README.zh.md",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jz0ojiang/mentionly.git",
    "directory": "packages/mentionly"
  },
  "homepage": "https://im0o.top/mentionly",
  "bugs": "https://github.com/jz0ojiang/mentionly/issues",
  "scripts": {
    "build": "vite build && vite build --config vite.style.config.ts && bun ../../scripts/build-llms.ts mentionly",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mentionly/vue": "^2.0.0-next.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "mention",
    "chat",
    "input",
    "contenteditable",
    "ai",
    "at-mention",
    "mentionly"
  ],
  "author": "jz0ojiang <hi@im0o.top> (https://github.com/jz0ojiang)",
  "license": "MIT"
}
