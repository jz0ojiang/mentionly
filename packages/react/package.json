{
  "name": "@mentionly/react",
  "version": "2.0.0-next.0",
  "type": "module",
  "description": "React hook for the mentionly contenteditable mention input",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jz0ojiang/mentionly.git",
    "directory": "packages/react"
  },
  "homepage": "https://im0o.top/mentionly",
  "bugs": "https://github.com/jz0ojiang/mentionly/issues",
  "scripts": {
    "build": "vite build && bun ../../scripts/build-llms.ts react",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mentionly/core": "^2.0.0-next.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "react",
    "mention",
    "chat",
    "input",
    "contenteditable",
    "ai",
    "at-mention"
  ],
  "author": "jz0ojiang <hi@im0o.top> (https://github.com/jz0ojiang)",
  "license": "MIT"
}
