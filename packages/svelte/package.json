{
  "name": "@mentionly/svelte",
  "version": "2.0.0-next.0",
  "type": "module",
  "description": "Svelte 5 mention input adapter for AI chat scenarios",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jz0ojiang/mentionly.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://im0o.top/mentionly",
  "bugs": "https://github.com/jz0ojiang/mentionly/issues",
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.build.json && bun ../../scripts/build-llms.ts svelte",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@mentionly/core": "^2.0.0-next.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.2.0",
    "jsdom": "^28.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "runes",
    "mention",
    "chat",
    "input",
    "contenteditable",
    "ai",
    "at-mention"
  ],
  "author": "jz0ojiang <hi@im0o.top> (https://github.com/jz0ojiang)",
  "license": "MIT"
}
